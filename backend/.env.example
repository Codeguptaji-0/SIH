# JWT signing key. Generate one with:
#     python -c "import secrets; print(secrets.token_urlsafe(48))"
# Minimum 32 characters. There is deliberately no default in source code: a signing
# key committed to a public repository is a published credential, and an ADMIN token
# could be forged from it with no password. With SECRET_KEY unset the app generates a
# random per-process key when DEMO_MODE=true (tokens do not survive a restart), and
# refuses to start when DEMO_MODE=false.
SECRET_KEY=o4VQa632TMUPcGr0ds-TT6sskGCBau7jUbreMe-CKhZ4WlV9AKirHMvYnB8B3KuQ

DEMO_MODE=true

# Live model provider. Leave AI_PROVIDER empty for the original behaviour: DEMO_MODE
# decides, and true means the deterministic MockAIProvider (no key, no network, the
# demo works on a train). Naming a provider here wins over DEMO_MODE, which is how a
# real key gets tested locally without also making SECRET_KEY mandatory and CORS
# strict. Valid values: anthropic, openai, mock.
AI_PROVIDER=

# Claude. ANTHROPIC_MODEL must be an ID your key can actually see - model IDs are
# dated strings, so ask rather than guess:
#     python -m pip install -r requirements-anthropic.txt
#     python check_anthropic.py
# That prints the IDs, then does one real generation with no silent fallback.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=

# OpenAI. Note the caveat above `openai==3.3.1` in requirements.txt: provider.py is
# written against the 1.x client shape and this path has never been exercised.
OPENAI_API_KEY=
DATABASE_URL=postgresql://postgres:Suraj%409891%23%24@db.lofreflhdfdnpsttjkku.supabase.co:5432/postgres
PORT=8000
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
