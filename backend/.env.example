# JWT signing key. Generate one with:
#     python -c "import secrets; print(secrets.token_urlsafe(48))"
# Minimum 32 characters. There is deliberately no default in source code: a signing
# key committed to a public repository is a published credential, and an ADMIN token
# could be forged from it with no password. With SECRET_KEY unset the app generates a
# random per-process key when DEMO_MODE=true (tokens do not survive a restart), and
# refuses to start when DEMO_MODE=false.
SECRET_KEY=

DEMO_MODE=true
OPENAI_API_KEY=
DATABASE_URL=sqlite:///./skillsetu.db
PORT=8000
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
