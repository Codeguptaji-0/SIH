# Where the frontend sends /api/... requests.
#
# app/lib/api.ts calls relative paths (/api/auth/login and so on) and
# next.config.js rewrites them to this origin. It is read on the SERVER during
# rewrite evaluation, so it deliberately has no NEXT_PUBLIC_ prefix and never
# reaches the browser bundle. Leave it unset for local development - the default
# in next.config.js is already http://127.0.0.1:8000.
#
# On Vercel set it to the deployed backend, scheme included and no trailing /api:
#   BACKEND_ORIGIN=https://skillsetu-api.onrender.com
BACKEND_ORIGIN=

# Unused. Nothing in the codebase reads this variable - it predates the rewrite
# approach and is kept only so an old .env.local does not look broken. Setting it
# has no effect; set BACKEND_ORIGIN above instead.
# NEXT_PUBLIC_API_URL=http://localhost:8000/api
